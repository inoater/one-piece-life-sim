[
  {
    "id": "evt_local_festival",
    "type": "local",
    "title": "Festival night",
    "text": "{place} held its festival: lanterns on every boat, music on every corner, and nobody working.",
    "trigger": "random",
    "weight": 2,
    "cooldown": 10,
    "conditions": [
      {
        "kind": "age",
        "min": 4
      }
    ],
    "roles": {
      "stranger": {
        "kind": "stranger",
        "ageOffset": {
          "min": -3,
          "max": 3
        }
      }
    },
    "choices": [
      {
        "id": "dance",
        "label": "Join the dancing",
        "check": {
          "stat": "charisma",
          "difficulty": 40,
          "success": {
            "text": "You danced until the lanterns burned down, mostly with {role.stranger.name}.",
            "effects": [
              {
                "kind": "meet",
                "role": "stranger",
                "as": "friend",
                "opinion": 30
              },
              {
                "kind": "train",
                "stats": {
                  "charisma": 1
                }
              }
            ]
          },
          "failure": {
            "text": "You trod on every foot in {place}.",
            "effects": [
              {
                "kind": "train",
                "stats": {
                  "charisma": 0.5
                }
              }
            ]
          }
        }
      },
      {
        "id": "eat",
        "label": "Eat your way round the stalls",
        "effects": [
          {
            "kind": "health",
            "fraction": 0.05
          },
          {
            "kind": "berries",
            "min": -300,
            "max": -100
          }
        ]
      }
    ],
    "tags": ["local", "social"]
  },
  {
    "id": "evt_local_pirate_raid",
    "type": "local",
    "title": "Pirates in the harbour",
    "text": "A pirate crew sailed into {place} at dawn, fired a cannon at the church tower for fun, and came ashore for whatever they could carry.",
    "trigger": "random",
    "weight": 1,
    "cooldown": 18,
    "conditions": [
      {
        "kind": "feature",
        "features": ["docks", "coast"]
      },
      {
        "kind": "danger",
        "min": 1
      }
    ],
    "weightMods": [
      {
        "when": [
          {
            "kind": "danger",
            "min": 3
          }
        ],
        "mult": 2.5
      },
      {
        "when": [
          {
            "kind": "feature",
            "features": ["marine_base"]
          }
        ],
        "mult": 0.3
      }
    ],
    "choices": [
      {
        "id": "hide",
        "label": "Hide and let them take what they want",
        "effects": [
          {
            "kind": "berries",
            "min": -3000,
            "max": -500
          }
        ]
      },
      {
        "id": "fight",
        "label": "Stand and fight",
        "requires": [
          {
            "kind": "age",
            "min": 14
          }
        ],
        "fight": {
          "scale": "skirmish",
          "foes": [
            {
              "kind": "foe",
              "foe": "foe_pirate_officer"
            },
            {
              "kind": "foe",
              "foe": "foe_pirate",
              "count": 2
            }
          ],
          "intent": "capture",
          "allies": "friends",
          "criticalSuccess": {
            "text": "You threw their captain off the pier, and the rest of them followed him.",
            "effects": [
              {
                "kind": "fame",
                "value": 15
              },
              {
                "kind": "deed"
              }
            ]
          },
          "success": {
            "text": "You and a few others held the harbour street until the pirates decided it was not worth it.",
            "effects": [
              {
                "kind": "fame",
                "value": 5
              }
            ]
          },
          "failure": {
            "text": "They beat you down in the street and took your purse as a lesson.",
            "effects": [
              {
                "kind": "berries",
                "min": -3000,
                "max": -1000
              }
            ]
          }
        }
      },
      {
        "id": "join",
        "label": "Ask if they need hands",
        "requires": [
          {
            "kind": "age",
            "min": 16
          }
        ],
        "effects": [
          {
            "kind": "infamy",
            "value": 8
          },
          {
            "kind": "flag",
            "flag": "path.pirate",
            "value": true
          },
          {
            "kind": "log",
            "text": "The captain laughed, and told you to look for them on the Grand Line if you lived that long.",
            "tags": ["pirate"]
          }
        ]
      }
    ],
    "tags": ["local", "pirate", "fight"]
  },
