        "effects": [
          {
            "kind": "delay",
            "months": 0.5
          },
          {
            "kind": "log",
            "text": "You waited. The wind came back in its own good time.",
            "tags": ["voyage"]
          }
        ]
      }
    ],
    "tags": ["voyage", "weather", "misfortune"]
