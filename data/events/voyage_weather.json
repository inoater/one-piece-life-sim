[
  {
    "id": "evt_voyage_storm",
    "type": "voyage",
    "title": "A storm",
    "text": "The sky went black by noon. By evening the {ship} was climbing waves as tall as her masts.",
    "trigger": "voyage",
    "weight": 3,
    "weightMods": [
      {
        "when": [
          {
            "kind": "season",
            "seasons": ["winter", "autumn"]
          }
        ],
        "mult": 1.5
      },
      {
        "when": [
          {
            "kind": "region",
            "regions": ["paradise", "new_world"]
          }
        ],
        "mult": 1.3
      }
    ],
    "choices": [
      {
        "id": "ride",
        "label": "Reef the sails and ride it out",
        "check": {
          "stat": "navigation",
          "difficulty": 40,
          "perDanger": 5,
          "criticalSuccess": {
            "text": "You read the storm like a book and let it carry you: the {ship} came out of it days ahead.",
            "effects": [
              {
                "kind": "delay",
                "months": -0.5
              }
            ]
          },
          "success": {
            "text": "You rode it out with a split sail and a few sprung planks.",
            "effects": [
              {
                "kind": "hull",
                "value": -2
              }
            ]
          },
          "failure": {
            "text": "The storm tore away a mast and half the stores, and blew you far off your course.",
            "effects": [
              {
                "kind": "hull",
                "value": -8
              },
              {
                "kind": "supplies",
                "months": -1
              },
              {
                "kind": "delay",
                "months": 0.5
              }
            ]
          },
          "criticalFailure": {
            "text": "A wave broke over the deck and took barrels, rigging and very nearly you.",
            "effects": [
              {
                "kind": "hull",
                "value": -15
              },
              {
                "kind": "supplies",
                "months": -2
              },
              {
                "kind": "delay",
                "months": 1
              },
              {
                "kind": "injury",
                "severity": "minor",
                "cause": "accident"
              }
            ]
          }
        }
      },
      {
        "id": "run",
        "label": "Run before the wind",
        "check": {
          "stat": "navigation",
          "difficulty": 50,
          "perDanger": 5,
          "success": {
            "text": "You ran before the gale and it flung you along your course.",
            "effects": [
              {
                "kind": "delay",
                "months": -0.5
              },
              {
                "kind": "hull",
                "value": -4
              }
            ]
          },
          "failure": {
            "text": "The wind took you where it liked, which was nowhere you wanted to be.",
            "effects": [
              {
                "kind": "delay",
                "months": 1
              },
              {
                "kind": "hull",
                "value": -10
              }
            ]
          }
        }
      }
    ],
    "tags": ["voyage", "weather", "misfortune"]
  },
  {
    "id": "evt_voyage_dead_calm",
    "type": "voyage",
    "title": "Dead calm",
