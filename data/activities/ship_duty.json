[
  {
    "id": "act_stand_watch",
    "name": "Stand watch",
    "category": "train_mind",
    "description": "Hours in the crow's nest or at the rail, watching the sea for trouble before it watches you.",
    "minAge": 10,
    "requires": { "atSea": true },
    "gains": { "perception": 0.6, "willpower": 0.2 },
    "tags": ["at_sea", "ship_duty"],
    "outcomes": [
      {
        "id": "quiet",
        "text": "A quiet watch: stars, spray and the creak of the rigging.",
        "weight": 3,
        "quiet": true
      },
      {
        "id": "spotted",
        "text": "You spotted a squall on the horizon in time for the {ship} to run around it.",
        "weight": 1,
        "statWeights": { "perception": 0.5 },
        "effects": [
          { "kind": "delay", "months": -0.1 },
          { "kind": "morale", "value": 2 }
        ]
      },
      {
        "id": "asleep",
        "text": "You fell asleep on watch and woke to the bosun's boot.",
        "weight": 0.4,
        "statWeights": { "willpower": -0.5 },
        "effects": [{ "kind": "morale", "value": -2 }]
      }
    ]
  },
  {
    "id": "act_work_rigging",
    "name": "Work the rigging",
    "category": "train_body",
    "description": "Up the ratlines, out along the yards, hauling and reefing in all weathers.",
    "minAge": 12,
    "physical": true,
    "requires": { "atSea": true },
    "gains": { "speed": 0.4, "dexterity": 0.4, "strength": 0.3 },
    "risk": { "injury": 0.03, "areas": { "arms": 2, "legs": 2, "torso": 1 } },
    "tags": ["at_sea", "ship_duty", "training"],
    "outcomes": [
      {
        "id": "hauled",
        "text": "You hauled and reefed until your palms were leather.",
        "weight": 3,
        "quiet": true
      },
      {
        "id": "trimmed",
        "text": "The sails drew better than they had all voyage, and the {ship} picked up a knot.",
        "weight": 1,
        "statWeights": { "dexterity": 0.5 },
        "effects": [{ "kind": "delay", "months": -0.1 }]
      },
      {
        "id": "fell",
        "text": "A footrope snapped under you and you dropped to the deck.",
        "weight": 0.3,
        "statWeights": { "dexterity": -0.5 },
        "effects": [{ "kind": "injury", "severity": "minor", "cause": "accident" }]
      }
    ]
  },
  {
    "id": "act_navigate",
    "name": "Help with the navigation",
    "category": "train_mind",
    "description": "Sun sights at noon, star sights at dusk, and long hours over the chart table.",
    "minAge": 12,
    "requires": { "atSea": true },
    "gains": { "intellect": 0.6, "perception": 0.2 },
    "tags": ["at_sea", "ship_duty", "study"],
    "outcomes": [
      {
        "id": "plotted",
        "text": "You worked the noon sight and plotted the {ship}'s position to the mile.",
        "weight": 3,
        "quiet": true
      },
      {
        "id": "shortcut",
        "text": "You spotted an error in the course and trimmed days off the passage to {destination}.",
        "weight": 1,
        "statWeights": { "intellect": 0.6 },
        "effects": [
          { "kind": "delay", "months": -0.2 },
          { "kind": "morale", "value": 2 }
        ]
      },
      {
        "id": "lost",
        "text": "Your sums came out wrong and the {ship} lost a day finding out.",
        "weight": 0.4,
        "statWeights": { "intellect": -0.6 },
        "effects": [{ "kind": "delay", "months": 0.05 }]
      }
    ]
  },
  {
    "id": "act_cook_galley",
    "name": "Cook for the crew",
    "category": "work",
    "description": "Turn salt pork, biscuit and whatever was caught today into something worth sitting down for.",
    "minAge": 10,
    "requires": { "atSea": true },
    "gains": { "dexterity": 0.2, "charisma": 0.2, "intellect": 0.1 },
    "hand": "cook",
    "tags": ["at_sea", "ship_duty", "cooking"],
    "outcomes": [
      {
        "id": "fed",
        "text": "Everyone ate, and nobody complained more than usual.",
        "weight": 3,
        "effects": [{ "kind": "morale", "value": 1 }],
        "quiet": true
      },
      {
        "id": "feast",
        "text": "You made something out of nothing, and the whole crew asked for seconds.",
        "weight": 1,
        "statWeights": { "dexterity": 0.4 },
        "effects": [
          { "kind": "morale", "value": 5 },
          { "kind": "supplies", "months": 0.3 }
        ]
      },
      {
        "id": "burnt",
        "text": "You burnt the stew. Nobody will let you forget it.",
        "weight": 0.5,
        "effects": [{ "kind": "morale", "value": -3 }]
      }
    ]
  },
  {
