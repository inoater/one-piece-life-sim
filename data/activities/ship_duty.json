    "physical": true,
    "requires": { "atSea": true },
    "gains": { "dexterity": 0.4, "strength": 0.2 },
    "hand": "ship",
    "tags": ["at_sea", "ship_duty", "craft"],
    "outcomes": [
      {
        "id": "patched",
        "text": "You worked over the {ship} from bow to stern, and she was the better for it.",
        "weight": 3,
        "effects": [{ "kind": "hull", "value": 2 }],
        "quiet": true
      },
      {
        "id": "good_job",
        "text": "You found rot in a frame before it found the sea, and replaced it.",
        "weight": 1,
        "statWeights": { "dexterity": 0.5 },
        "effects": [{ "kind": "hull", "value": 5 }]
      }
    ]
  },
  {
