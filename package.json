{
  "name": "one-piece-life-sim",
  "version": "0.9.0",
  "private": true,
  "description": "One Piece Life Sim: a static-site life simulation. Phase 8: recruitment, the crew creator, positions aboard, teammates who grow, missions, fleets, bases, prisoners and spies, on the heart, weapons and ships, battles, powers, the world, the life loop and character genesis.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "vite build --mode preview && tsx tools/inline-html.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "tsx tools/validate-data.ts && tsx tools/canon-lint.ts",
    "lint:sim": "tsx tools/lint-sim.ts",
    "sim": "tsx tools/headless-sim.ts",
    "genesis": "tsx tools/genesis.ts",
    "lives": "tsx tools/lives.ts",
    "world": "tsx tools/world.ts",
    "powers": "tsx tools/powers.ts",
    "battle": "tsx tools/battle.ts",
    "economy": "tsx tools/economy.ts",
    "heart": "tsx tools/heart.ts",
    "crew": "tsx tools/crew.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden:update": "tsx tools/update-golden.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run validate && npm run lint:sim && npm run test && npm run format:check",
    "prepare": "git config core.hooksPath .githooks || true",
    "e2e": "npm run build:preview && vitest run --config vitest.e2e.config.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "oxc-parser": "^0.154.0",
    "playwright-core": "^1.56.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
